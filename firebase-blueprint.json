{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile record for students and academic members",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase Auth user ID",
          "maxLength": 128
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the student or member",
          "maxLength": 100
        },
        "nim": {
          "type": "string",
          "description": "Student identification number (NIM)",
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the user",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "Academic role of the user, e.g. Mahasiswa IBIKKG",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when account profile was registered"
        }
      },
      "required": ["uid", "fullName", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents keyed by Firebase Auth uid"
    }
  }
}
